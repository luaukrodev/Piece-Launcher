    <sys:String x:Key="Lang_ProfileManagement_Cancel">Abbrechen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Save">Änderungen speichern</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_MicrosoftNameReadOnly">Microsoft-Kontonamen können hier nicht bearbeitet werden.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Skin">Skin</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinDescription">Offline-Profile starten mit einem neutralen Modell. Ziehe es zum Drehen. Importiere eine 64x64- oder 64x32-Skin-PNG; gespeicherte Skins werden in der Launcher-Vorschau verwendet.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinMicrosoftReadOnly">Microsoft-Konto-Skins können hier angezeigt, aber nicht geändert werden.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_EditSkin">Skin-PNG auswählen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SaveSkin">Skin speichern</sys:String>

    <!-- Versions Page -->
    <sys:String x:Key="Lang_Versions_Title">Versionen</sys:String>
