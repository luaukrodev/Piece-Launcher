    <sys:String x:Key="Lang_Settings_AutoRamDescription">Der Launcher wählt beim Spielstart eine empfohlene Speichermenge.</sys:String>
    <sys:String x:Key="Lang_Settings_CustomRam">Benutzerdefinierter Arbeitsspeicher</sys:String>
    <sys:String x:Key="Lang_Settings_SafeModeLimit">Arbeitsspeicher auf höchstens die Hälfte des Systems begrenzen</sys:String>
    <sys:String x:Key="Lang_Settings_DefaultLoader">Standard-Modloader</sys:String>
    <sys:String x:Key="Lang_Settings_GitHub">GitHub</sys:String>
    <sys:String x:Key="Lang_Settings_Releases">Veröffentlichungen</sys:String>
