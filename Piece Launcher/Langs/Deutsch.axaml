    <sys:String x:Key="Lang_Profiles_Manage">Profil verwalten</sys:String>

    <!-- Profile Management Page -->
    <sys:String x:Key="Lang_ProfileManagement_Title">Profil verwalten</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Subtitle">Bearbeite dieses Profil und sieh dir die Kontodetails an.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Back">Zurück zu den Profilen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Name">Profilname</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Type">Kontotyp</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Microsoft">Microsoft</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Offline">Offline</sys:String>
