    <sys:String x:Key="Lang_Versions_QuiltDesc">Nächste Generation</sys:String>

    <!-- Explore Page -->
    <sys:String x:Key="Lang_Explore_Title">Entdecken</sys:String>
    <sys:String x:Key="Lang_Explore_Subtitle">Suche und installiere Mods, Shader und Karten aus der Community.</sys:String>
