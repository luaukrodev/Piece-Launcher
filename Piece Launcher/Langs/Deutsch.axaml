    <sys:String x:Key="Lang_Settings_UpdatesDescription">Der Launcher sucht beim Start auf GitHub nach Updates.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesRequireInstall">Updates sind für die installierte Launcher-Version verfügbar.</sys:String>
    <sys:String x:Key="Lang_Settings_CheckForUpdates">Nach Updates suchen</sys:String>
    <sys:String x:Key="Lang_Settings_CheckingForUpdates">Suche nach Updates...</sys:String>
    <sys:String x:Key="Lang_Settings_UpToDate">Du verwendest die aktuelle Version.</sys:String>
