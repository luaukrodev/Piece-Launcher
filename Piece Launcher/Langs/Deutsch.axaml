    <sys:String x:Key="Lang_MinecraftMods_NoImage">Kein Bild</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_PoweredBy">Unterstützt von</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_OpenModsFolder">Mods-Ordner öffnen</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Previous">Zurück</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Next">Weiter</sys:String>

    <!-- Community Page -->
    <sys:String x:Key="Lang_Community_Title">Community</sys:String>
    <sys:String x:Key="Lang_Community_Subtitle">Ich arbeite daran. Es wird ein großes Projekt, daher brauche ich ein paar Wochen, um es fertigzustellen. Bleib dran!</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="Lang_Settings_Title">Einstellungen</sys:String>
    <sys:String x:Key="Lang_Settings_Subtitle">Passe deinen Launcher und dein Spielerlebnis an.</sys:String>
    <sys:String x:Key="Lang_Settings_General">Allgemein</sys:String>
    <sys:String x:Key="Lang_Settings_Appearance">Erscheinungsbild</sys:String>
    <sys:String x:Key="Lang_Settings_Game">Spiel</sys:String>
    <sys:String x:Key="Lang_Settings_Memory">Arbeitsspeicher</sys:String>
    <sys:String x:Key="Lang_Settings_Versions">Versionen</sys:String>
    <sys:String x:Key="Lang_Settings_About">Über</sys:String>
