<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- Navigation -->
    <sys:String x:Key="Lang_Nav_Home">Startseite</sys:String>
    <sys:String x:Key="Lang_Nav_Profiles">Profile</sys:String>
    <sys:String x:Key="Lang_Nav_Versions">Versionen</sys:String>
    <sys:String x:Key="Lang_Nav_MinecraftMods">Minecraft-Mods</sys:String>
    <sys:String x:Key="Lang_Nav_Community">Gemeinschaft</sys:String>
    <sys:String x:Key="Lang_Nav_Settings">Einstellungen</sys:String>

    <!-- Global / Launch Bar -->
    <sys:String x:Key="Lang_Global_Player">SPIELER</sys:String>
    <sys:String x:Key="Lang_Global_Type">TYP</sys:String>
    <sys:String x:Key="Lang_Global_Version">VERSION</sys:String>
    <sys:String x:Key="Lang_Global_Loading">Wird geladen...</sys:String>
    <sys:String x:Key="Lang_Global_Play">▶  SPIELEN</sys:String>

    <!-- Home Page -->
    <sys:String x:Key="Lang_Home_ReadyToPlay">BEREIT ZUM SPIELEN</sys:String>
    <sys:String x:Key="Lang_Home_WelcomeBack">Willkommen zurück,</sys:String>
    <sys:String x:Key="Lang_Home_ChooseVersion">Wähle deine Version und tauche ein.</sys:String>
    <sys:String x:Key="Lang_Home_MsAccount">Microsoft-Konto</sys:String>
    <sys:String x:Key="Lang_Home_MsAccountDesc">Melde dich an für Online-Spiele &amp; Skins</sys:String>
    <sys:String x:Key="Lang_Home_SignInMs">Mit Microsoft anmelden</sys:String>

    <!-- Profiles Page -->
    <sys:String x:Key="Lang_Profiles_Title">PROFILE</sys:String>
    <sys:String x:Key="Lang_Profiles_Subtitle">Meine Profile</sys:String>
    <sys:String x:Key="Lang_Profiles_NewProfile">Neues Profil</sys:String>
    <sys:String x:Key="Lang_Profiles_ProfileNameWatermark">Profilname...</sys:String>
    <sys:String x:Key="Lang_Profiles_AddOffline">Offline hinzufügen</sys:String>
    <sys:String x:Key="Lang_Profiles_NoProfiles">Noch keine Profile</sys:String>
    <sys:String x:Key="Lang_Profiles_ClickToAdd">Klicke auf "Neues Profil" um eines hinzuzufügen</sys:String>
    <sys:String x:Key="Lang_Profiles_Remove">Entfernen</sys:String>
    <sys:String x:Key="Lang_Profiles_Manage">Profil verwalten</sys:String>

    <!-- Profile Management Page -->
    <sys:String x:Key="Lang_ProfileManagement_Title">Profil verwalten</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Subtitle">Bearbeite dieses Profil und sieh dir die Kontodetails an.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Back">Zurück zu den Profilen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Name">Profilname</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Type">Kontotyp</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Microsoft">Microsoft</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Offline">Offline</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Id">Profil-ID</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Cancel">Abbrechen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Save">Änderungen speichern</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_MicrosoftNameReadOnly">Microsoft-Kontonamen können hier nicht bearbeitet werden.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Skin">Skin</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinDescription">Offline-Profile starten mit einem neutralen Modell. Ziehe es zum Drehen. Importiere eine 64x64- oder 64x32-Skin-PNG; gespeicherte Skins werden in der Launcher-Vorschau verwendet.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinMicrosoftReadOnly">Microsoft-Konto-Skins können hier angezeigt, aber nicht geändert werden.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_EditSkin">Skin-PNG auswählen</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SaveSkin">Skin speichern</sys:String>

    <!-- Versions Page -->
    <sys:String x:Key="Lang_Versions_Title">Versionen</sys:String>
    <sys:String x:Key="Lang_Versions_Subtitle">Installiere und verwalte Spielversionen, Mod-Loader und Einstellungen.</sys:String>
    <sys:String x:Key="Lang_Versions_InstallGame">Spielversionen installieren</sys:String>
    <sys:String x:Key="Lang_Versions_InstallGameDesc">Lade neue Minecraft-Versionen herunter und installiere sie.</sys:String>
    <sys:String x:Key="Lang_Versions_SearchWatermark">Versionen suchen...</sys:String>
    <sys:String x:Key="Lang_Versions_Snapshots">Snapshots</sys:String>
    <sys:String x:Key="Lang_Versions_Betas">Betas</sys:String>
    <sys:String x:Key="Lang_Versions_Alphas">Alphas</sys:String>
    <sys:String x:Key="Lang_Versions_OldVersions">Alte Versionen</sys:String>
    <sys:String x:Key="Lang_Versions_Installed">Installiert</sys:String>
    <sys:String x:Key="Lang_Versions_InstallBtn">Installieren</sys:String>
    <sys:String x:Key="Lang_Versions_ModLoaders">Mod Loader</sys:String>
    <sys:String x:Key="Lang_Versions_ModLoadersDesc">Installiere Mod-Loader, um gemoddetes Minecraft zu spielen.</sys:String>
    <sys:String x:Key="Lang_Versions_TargetMinecraft">Ziel-Minecraft-Version:</sys:String>
    <sys:String x:Key="Lang_Versions_SelectLoader">Mod-Loader auswählen</sys:String>
    <sys:String x:Key="Lang_Versions_LoaderVersion">Loader-Version</sys:String>
    <sys:String x:Key="Lang_Versions_SelectVersionWatermark">Version auswählen...</sys:String>
    <sys:String x:Key="Lang_Versions_Recommended">Empfohlen</sys:String>
    <sys:String x:Key="Lang_Versions_LoaderAlreadyInstalled">Dieser Loader ist für diese Version bereits installiert!</sys:String>
    <sys:String x:Key="Lang_Versions_FabricDesc">Leicht &amp; Schnell</sys:String>
    <sys:String x:Key="Lang_Versions_ForgeDesc">Klassisch &amp; Robust</sys:String>
    <sys:String x:Key="Lang_Versions_NeoForgeDesc">Modernes Fork</sys:String>
    <sys:String x:Key="Lang_Versions_QuiltDesc">Nächste Generation</sys:String>

    <!-- Minecraft Mods Page -->
    <sys:String x:Key="Lang_MinecraftMods_Title">Minecraft Mods</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Subtitle">Suche und installiere Mods, Shader und Karten aus der Community.</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_SearchWatermark">Mods, Shader, Karten suchen...</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_SearchBtn">Suchen</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Filters">Filter</sys:String>
