    <!-- Maps Page -->
    <sys:String x:Key="Lang_Maps_Title">Karten</sys:String>
    <sys:String x:Key="Lang_Maps_Subtitle">In diesem Abschnitt werden vorgestellte Karten angezeigt und Community-Karten durchsucht.</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="Lang_Settings_Title">Einstellungen</sys:String>
    <sys:String x:Key="Lang_Settings_Subtitle">Passe deinen Launcher und dein Spielerlebnis an.</sys:String>
