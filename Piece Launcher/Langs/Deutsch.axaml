    <sys:String x:Key="Lang_Settings_StartupPage">Startseite</sys:String>
    <sys:String x:Key="Lang_Settings_LaunchStartup">Beim Windows-Start ausführen</sys:String>
    <sys:String x:Key="Lang_Settings_KeepOpen">Launcher geöffnet lassen, während Minecraft läuft</sys:String>
    <sys:String x:Key="Lang_Settings_Reset">Auf Standard zurücksetzen</sys:String>
