    <sys:String x:Key="Lang_Settings_Theme">Design</sys:String>
    <sys:String x:Key="Lang_Settings_StartupPage">Startseite</sys:String>
    <sys:String x:Key="Lang_Settings_LaunchStartup">Beim Windows-Start ausführen</sys:String>
