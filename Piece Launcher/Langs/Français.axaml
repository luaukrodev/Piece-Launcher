    <sys:String x:Key="Lang_Settings_ComingSoon">Bientôt disponible</sys:String>
    <sys:String x:Key="Lang_Settings_AutoRam">Utiliser automatiquement la mémoire recommandée</sys:String>
    <sys:String x:Key="Lang_Settings_AutoRamDescription">Le lanceur choisit une quantité de mémoire recommandée au démarrage du jeu.</sys:String>
    <sys:String x:Key="Lang_Settings_CustomRam">Mémoire personnalisée</sys:String>
    <sys:String x:Key="Lang_Settings_SafeModeLimit">Limiter la mémoire à la moitié au maximum de la RAM système</sys:String>
    <sys:String x:Key="Lang_Settings_DefaultLoader">Chargeur de mods par défaut</sys:String>
    <sys:String x:Key="Lang_Settings_GitHub">GitHub</sys:String>
    <sys:String x:Key="Lang_Settings_Releases">Versions publiées</sys:String>
    <sys:String x:Key="Lang_Settings_License">Licence</sys:String>
