    <sys:String x:Key="Lang_Settings_Version">Version :</sys:String>
    <sys:String x:Key="Lang_Settings_AutomaticUpdates">Rechercher automatiquement les mises à jour du lanceur</sys:String>
    <sys:String x:Key="Lang_Settings_Updates">Mises à jour du lanceur</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesDescription">Le lanceur recherche des mises à jour sur GitHub au démarrage.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesRequireInstall">Les mises à jour sont disponibles pour la version installée du lanceur.</sys:String>
    <sys:String x:Key="Lang_Settings_CheckForUpdates">Rechercher des mises à jour</sys:String>
    <sys:String x:Key="Lang_Settings_CheckingForUpdates">Recherche des mises à jour...</sys:String>
    <sys:String x:Key="Lang_Settings_UpToDate">Vous utilisez la dernière version.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdateAvailable">Mise à jour disponible :</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadUpdate">Télécharger et redémarrer</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadingUpdate">Téléchargement de la mise à jour...</sys:String>
