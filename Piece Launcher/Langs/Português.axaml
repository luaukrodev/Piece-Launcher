    <sys:String x:Key="Lang_Settings_UpdatesDescription">O launcher verifica atualizações no GitHub ao iniciar.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesRequireInstall">As atualizações estão disponíveis para a versão instalada do launcher.</sys:String>
    <sys:String x:Key="Lang_Settings_CheckForUpdates">Verificar atualizações</sys:String>
    <sys:String x:Key="Lang_Settings_CheckingForUpdates">Verificando atualizações...</sys:String>
    <sys:String x:Key="Lang_Settings_UpToDate">Você está usando a versão mais recente.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdateAvailable">Atualização disponível:</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadUpdate">Baixar e reiniciar</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadingUpdate">Baixando atualização...</sys:String>
    <sys:String x:Key="Lang_Settings_UpdateFailed">Falha ao verificar ou baixar atualização:</sys:String>

</ResourceDictionary>
