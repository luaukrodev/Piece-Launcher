<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- Navigation -->
    <sys:String x:Key="Lang_Nav_Home">Inicio</sys:String>
    <sys:String x:Key="Lang_Nav_Profiles">Perfiles</sys:String>
    <sys:String x:Key="Lang_Nav_Versions">Versiones</sys:String>
    <sys:String x:Key="Lang_Nav_MinecraftMods">Mods de Minecraft</sys:String>
    <sys:String x:Key="Lang_Nav_Community">Comunidad</sys:String>
    <sys:String x:Key="Lang_Nav_Settings">Ajustes</sys:String>

    <!-- Global / Launch Bar -->
    <sys:String x:Key="Lang_Global_Player">JUGADOR</sys:String>
    <sys:String x:Key="Lang_Global_Type">TIPO</sys:String>
    <sys:String x:Key="Lang_Global_Version">VERSIÓN</sys:String>
    <sys:String x:Key="Lang_Global_Loading">Cargando...</sys:String>
    <sys:String x:Key="Lang_Global_Play">▶  JUGAR</sys:String>

    <!-- Home Page -->
    <sys:String x:Key="Lang_Home_ReadyToPlay">LISTO PARA JUGAR</sys:String>
    <sys:String x:Key="Lang_Home_WelcomeBack">Bienvenido de nuevo,</sys:String>
    <sys:String x:Key="Lang_Home_ChooseVersion">Elige tu versión y diviértete.</sys:String>
    <sys:String x:Key="Lang_Home_MsAccount">Cuenta de Microsoft</sys:String>
    <sys:String x:Key="Lang_Home_MsAccountDesc">Inicia sesión para jugar en línea y usar skins</sys:String>
    <sys:String x:Key="Lang_Home_SignInMs">Iniciar sesión con Microsoft</sys:String>

    <!-- Profiles Page -->
    <sys:String x:Key="Lang_Profiles_Title">PERFILES</sys:String>
    <sys:String x:Key="Lang_Profiles_Subtitle">Mis Perfiles</sys:String>
    <sys:String x:Key="Lang_Profiles_NewProfile">Nuevo Perfil</sys:String>
    <sys:String x:Key="Lang_Profiles_ProfileNameWatermark">Nombre del perfil...</sys:String>
    <sys:String x:Key="Lang_Profiles_AddOffline">Añadir Offline</sys:String>
    <sys:String x:Key="Lang_Profiles_NoProfiles">Aún no hay perfiles</sys:String>
    <sys:String x:Key="Lang_Profiles_ClickToAdd">Haz clic en "Nuevo Perfil" para añadir</sys:String>
    <sys:String x:Key="Lang_Profiles_Remove">Eliminar</sys:String>
    <sys:String x:Key="Lang_Profiles_Manage">Administrar perfil</sys:String>

    <!-- Profile Management Page -->
    <sys:String x:Key="Lang_ProfileManagement_Title">Administrar perfil</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Subtitle">Edita este perfil y consulta los datos de la cuenta.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Back">Volver a los perfiles</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Name">Nombre del perfil</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Type">Tipo de cuenta</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Microsoft">Microsoft</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Offline">Sin conexión</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Id">ID del perfil</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Cancel">Cancelar</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Save">Guardar cambios</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_MicrosoftNameReadOnly">Los nombres de cuentas Microsoft no se pueden editar aquí.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_Skin">Skin</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinDescription">Los perfiles sin conexión comienzan con un modelo neutro. Arrástralo para girarlo. Importa un PNG de skin de 64x64 o 64x32; las skins guardadas se usan en la vista previa del launcher.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SkinMicrosoftReadOnly">Las skins de cuentas Microsoft se pueden ver aquí, pero no cambiar.</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_EditSkin">Elegir PNG de skin</sys:String>
    <sys:String x:Key="Lang_ProfileManagement_SaveSkin">Guardar skin</sys:String>

    <!-- Versions Page -->
    <sys:String x:Key="Lang_Versions_Title">Versiones</sys:String>
    <sys:String x:Key="Lang_Versions_Subtitle">Instala y gestiona versiones del juego, mod loaders y ajustes.</sys:String>
    <sys:String x:Key="Lang_Versions_InstallGame">Instalar Versiones del Juego</sys:String>
    <sys:String x:Key="Lang_Versions_InstallGameDesc">Descarga e instala nuevas versiones de Minecraft.</sys:String>
    <sys:String x:Key="Lang_Versions_SearchWatermark">Buscar versiones...</sys:String>
    <sys:String x:Key="Lang_Versions_Snapshots">Snapshots</sys:String>
    <sys:String x:Key="Lang_Versions_Betas">Betas</sys:String>
    <sys:String x:Key="Lang_Versions_Alphas">Alphas</sys:String>
    <sys:String x:Key="Lang_Versions_OldVersions">Versiones Antiguas</sys:String>
    <sys:String x:Key="Lang_Versions_Installed">Instalado</sys:String>
    <sys:String x:Key="Lang_Versions_InstallBtn">Instalar</sys:String>
    <sys:String x:Key="Lang_Versions_ModLoaders">Mod Loaders</sys:String>
    <sys:String x:Key="Lang_Versions_ModLoadersDesc">Instala mod loaders para jugar a Minecraft con mods.</sys:String>
    <sys:String x:Key="Lang_Versions_TargetMinecraft">Versión de Minecraft objetivo:</sys:String>
    <sys:String x:Key="Lang_Versions_SelectLoader">Seleccionar Mod Loader</sys:String>
    <sys:String x:Key="Lang_Versions_LoaderVersion">Versión del Loader</sys:String>
    <sys:String x:Key="Lang_Versions_SelectVersionWatermark">Seleccionar versión...</sys:String>
    <sys:String x:Key="Lang_Versions_Recommended">Recomendado</sys:String>
    <sys:String x:Key="Lang_Versions_LoaderAlreadyInstalled">¡Este loader ya está instalado para esta versión!</sys:String>
    <sys:String x:Key="Lang_Versions_FabricDesc">Ligero y Rápido</sys:String>
    <sys:String x:Key="Lang_Versions_ForgeDesc">Clásico y Robusto</sys:String>
    <sys:String x:Key="Lang_Versions_NeoForgeDesc">Fork Moderno</sys:String>
    <sys:String x:Key="Lang_Versions_QuiltDesc">Próxima Generación</sys:String>

    <!-- Minecraft Mods Page -->
    <sys:String x:Key="Lang_MinecraftMods_Title">Minecraft Mods</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Subtitle">Busca e instala mods, shaders y mapas de la comunidad.</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_SearchWatermark">Buscar mods, shaders, mapas...</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_SearchBtn">Buscar</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Filters">Filtros</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Type">Tipo:</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Source">Fuente:</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Sort">Ordenar por:</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_NoImage">Sin Imagen</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_PoweredBy">Desarrollado por</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_OpenModsFolder">Abrir carpeta de mods</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Previous">Anterior</sys:String>
    <sys:String x:Key="Lang_MinecraftMods_Next">Siguiente</sys:String>

    <!-- Community Page -->
    <sys:String x:Key="Lang_Community_Title">Community</sys:String>
    <sys:String x:Key="Lang_Community_Subtitle">Estoy trabajando en esto. Será un proyecto grande, así que necesitaré un par de semanas para terminarlo. ¡Mantente al tanto!</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="Lang_Settings_Title">Ajustes</sys:String>
    <sys:String x:Key="Lang_Settings_Subtitle">Personaliza tu launcher y experiencia de juego.</sys:String>
    <sys:String x:Key="Lang_Settings_General">General</sys:String>
    <sys:String x:Key="Lang_Settings_Appearance">Apariencia</sys:String>
    <sys:String x:Key="Lang_Settings_Game">Juego</sys:String>
    <sys:String x:Key="Lang_Settings_Memory">Memoria</sys:String>
    <sys:String x:Key="Lang_Settings_Versions">Versiones</sys:String>
    <sys:String x:Key="Lang_Settings_About">Acerca de</sys:String>
    <sys:String x:Key="Lang_Settings_Sections">Secciones</sys:String>
    <sys:String x:Key="Lang_Settings_AutoDetectJava">Detectar Java automáticamente</sys:String>
    <sys:String x:Key="Lang_Settings_JavaPath">Ruta del ejecutable Java</sys:String>
    <sys:String x:Key="Lang_Settings_JavaArguments">Argumentos JVM adicionales</sys:String>
    <sys:String x:Key="Lang_Settings_GameDirectory">Carpeta actual del juego</sys:String>
    <sys:String x:Key="Lang_Settings_OpenFolder">Abrir carpeta</sys:String>
    <sys:String x:Key="Lang_Settings_MinimizeToTray">Minimizar en la bandeja</sys:String>
    <sys:String x:Key="Lang_Settings_MinecraftConsole">Mostrar consola de Minecraft</sys:String>
    <sys:String x:Key="Lang_Settings_ComingSoon">Próximamente</sys:String>
    <sys:String x:Key="Lang_Settings_AutoRam">Usar memoria recomendada automáticamente</sys:String>
    <sys:String x:Key="Lang_Settings_AutoRamDescription">El launcher elige una cantidad de memoria recomendada al iniciar el juego.</sys:String>
    <sys:String x:Key="Lang_Settings_CustomRam">Memoria personalizada</sys:String>
    <sys:String x:Key="Lang_Settings_SafeModeLimit">Limitar la memoria a como máximo la mitad de la RAM del sistema</sys:String>
    <sys:String x:Key="Lang_Settings_DefaultLoader">Cargador predeterminado</sys:String>
    <sys:String x:Key="Lang_Settings_GitHub">GitHub</sys:String>
    <sys:String x:Key="Lang_Settings_Releases">Versiones</sys:String>
    <sys:String x:Key="Lang_Settings_License">Licencia</sys:String>
    <sys:String x:Key="Lang_Settings_OpenDataFolder">Abrir carpeta de datos del launcher</sys:String>
    <sys:String x:Key="Lang_Settings_InvalidJavaPath">No se encontró el ejecutable Java seleccionado.</sys:String>
    <sys:String x:Key="Lang_Settings_StartupWindowsOnly">El registro de inicio solo está disponible en Windows.</sys:String>
    <sys:String x:Key="Lang_Settings_StartupRegistryUnavailable">No se pudo abrir la clave del registro de inicio de Windows.</sys:String>
    <sys:String x:Key="Lang_Settings_LauncherPathUnavailable">No se pudo determinar la ruta del ejecutable del launcher.</sys:String>
    <sys:String x:Key="Lang_Settings_Language">Idioma</sys:String>
    <sys:String x:Key="Lang_Settings_Theme">Tema</sys:String>
    <sys:String x:Key="Lang_Settings_StartupPage">Página de Inicio</sys:String>
    <sys:String x:Key="Lang_Settings_LaunchStartup">Iniciar con Windows</sys:String>
    <sys:String x:Key="Lang_Settings_KeepOpen">Mantener el launcher abierto mientras Minecraft está en ejecución</sys:String>
    <sys:String x:Key="Lang_Settings_Reset">Restablecer Valores</sys:String>
    <sys:String x:Key="Lang_Settings_Save">Guardar Ajustes</sys:String>
    <sys:String x:Key="Lang_Settings_Version">Versión:</sys:String>
    <sys:String x:Key="Lang_Settings_AutomaticUpdates">Buscar actualizaciones del launcher automáticamente</sys:String>
    <sys:String x:Key="Lang_Settings_Updates">Actualizaciones del launcher</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesDescription">El launcher busca actualizaciones en GitHub al iniciarse.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdatesRequireInstall">Las actualizaciones están disponibles para la versión instalada del launcher.</sys:String>
    <sys:String x:Key="Lang_Settings_CheckForUpdates">Buscar actualizaciones</sys:String>
    <sys:String x:Key="Lang_Settings_CheckingForUpdates">Buscando actualizaciones...</sys:String>
    <sys:String x:Key="Lang_Settings_UpToDate">Estás usando la última versión.</sys:String>
    <sys:String x:Key="Lang_Settings_UpdateAvailable">Actualización disponible:</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadUpdate">Descargar y reiniciar</sys:String>
    <sys:String x:Key="Lang_Settings_DownloadingUpdate">Descargando actualización...</sys:String>
    <sys:String x:Key="Lang_Settings_UpdateFailed">No se pudo buscar o descargar la actualización:</sys:String>

</ResourceDictionary>
