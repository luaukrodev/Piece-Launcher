<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             x:Class="Piece_Launcher.Views.Pages.CommunityPageView"
             x:DataType="vm:CommunityPageViewModel">

    <ScrollViewer Margin="0">
        <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource Lang_Community_Title}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Lang_Community_Subtitle}" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
            <!-- Placeholder cards -->
            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="120" CornerRadius="0" Background="{DynamicResource ThemeCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" Padding="16" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_Community_MapTitle}" FontWeight="SemiBold" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang_Community_AuthorDownloads}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
