<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             xmlns:helpers="using:Piece_Launcher.Helpers"
             x:Class="Piece_Launcher.Views.Pages.ModDetailPageView"
             x:DataType="vm:ModDetailPageViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Navigation -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="44,12,44,12">
            <Button Content="← Back" Command="{Binding GoBackCommand}" Classes="SidebarButton" Padding="12,8" Background="{DynamicResource CardBackground}"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="44,0,44,16">
            <Grid ColumnDefinitions="*, 300">
                <!-- Left Content: Header & Tabs -->
                <StackPanel Grid.Column="0" Spacing="24" Margin="0,0,24,0">
                    
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="16" Background="{DynamicResource InnerCardBackground}" ClipToBounds="True" Margin="0,0,16,0">
                            <Image helpers:ImageAsyncHelper.SourceUrl="{Binding Project.IconUrl}" Stretch="UniformToFill"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Project.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Project.Author}" FontSize="14" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{Binding Project.Description}" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Tab Strip -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- Tab 0: Description -->
                            <Button Content="Description" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="0" 
                                    Classes="SidebarButton" Padding="16,8"/>
                            <!-- Tab 1: Gallery -->
                            <Button Content="Gallery" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="1" 
                                    Classes="SidebarButton" Padding="16,8"/>
                            <!-- Tab 2: Versions -->
                            <Button Content="Versions" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="2" 
                                    Classes="SidebarButton" Padding="16,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Contents -->
                    <Panel>
                        <!-- Description Tab -->
                        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                      Margin="0,8,0,0" MaxHeight="500">
                            <TextBlock Text="{Binding Project.Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="13" LineHeight="22"/>
                        </ScrollViewer>

                        <!-- Gallery Tab -->
                        <ItemsControl IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}" 
                                      ItemsSource="{Binding Gallery}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="180" CornerRadius="12" Margin="0,0,16,16" ClipToBounds="True">
                                        <Image helpers:ImageAsyncHelper.SourceUrl="{Binding}" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Versions Tab -->
                        <ItemsControl IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}" 
                                      ItemsSource="{Binding Versions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding VersionNumber}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Install" Command="{Binding $parent[UserControl].((vm:ModDetailPageViewModel)DataContext).InstallVersionCommand}" CommandParameter="{Binding}" Classes="PlayButton" Padding="16,8" Background="{DynamicResource PlayBtnTop}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </StackPanel>

                <!-- Right Content: Install Floating Panel & Metadata -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                            <Button Content="Install" Command="{Binding InstallLatestCommand}" HorizontalAlignment="Stretch" Classes="PlayButton" Padding="0,12" Background="{DynamicResource PlayBtnTop}"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Downloads" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding Project.Downloads}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="License" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding Project.License}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
