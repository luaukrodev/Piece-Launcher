<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             xmlns:helpers="using:Piece_Launcher.Helpers"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:converters="using:Piece_Launcher.Converters"
             x:Class="Piece_Launcher.Views.Pages.ModDetailPageView"
             x:DataType="vm:ModDetailPageViewModel">

    <UserControl.Resources>
        <converters:CompactDownloadCountConverter x:Key="CompactDownloadCountConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Navigation -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Content="{DynamicResource Lang_Global_Back}" Command="{Binding GoBackCommand}" Classes="piece" Background="{DynamicResource ThemeCardBackgroundBrush}"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="0">
            <Grid ColumnDefinitions="*, 300">
                <!-- Left Content: Header & Tabs -->
                <StackPanel Grid.Column="0" Spacing="24" Margin="0,0,24,0">
                    
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="0" Background="{DynamicResource ThemeSidebarBackgroundBrush}" ClipToBounds="True" Margin="0,0,16,0">
                            <Image helpers:ImageAsyncHelper.SourceUrl="{Binding Project.IconUrl}" Stretch="UniformToFill"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Project.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Project.Author}" FontSize="14" Foreground="{DynamicResource PieceOrangeFaceBrush}"/>
                            <TextBlock Text="{Binding Project.Description}" FontSize="13" Foreground="{DynamicResource PieceTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Tab Strip -->
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" CornerRadius="0" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- Tab 0: Description -->
                            <Button Content="{DynamicResource Lang_Global_Description}" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="0"
                                    Classes="piece" Padding="16,8"/>
                            <!-- Tab 1: Gallery -->
                            <Button Content="{DynamicResource Lang_Global_Gallery}" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="1"
                                    Classes="piece" Padding="16,8"/>
                            <!-- Tab 2: Versions -->
                            <Button Content="{DynamicResource Lang_Nav_Versions}" Command="{Binding SetSelectedTabIndexCommand}" CommandParameter="2"
                                    Classes="piece" Padding="16,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Contents -->
                    <Panel>
                        <!-- Description Tab -->
                        <md:MarkdownScrollViewer IsVisible="{Binding IsDescriptionTab}"
                                                 Markdown="{Binding Project.Body}"
                                                 Margin="0,8,0,0" MaxHeight="500">
                            <md:MarkdownScrollViewer.Styles>
                                <Style Selector="ctxt|CTextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PieceTextPrimaryBrush}"/>
                                </Style>
                                <Style Selector="ctxt|CCode">
                                    <Setter Property="Foreground" Value="{DynamicResource PieceTextPrimaryBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource ThemeSidebarBackgroundBrush}"/>
                                </Style>
                                <Style Selector="Border.CodeBlock">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSidebarBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
                                    <Setter Property="Padding" Value="12"/>
                                </Style>
                                <Style Selector="TextBlock.CodeBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PieceTextPrimaryBrush}"/>
                                </Style>
                            </md:MarkdownScrollViewer.Styles>
                        </md:MarkdownScrollViewer>

                        <!-- Gallery Tab -->
                        <ItemsControl IsVisible="{Binding IsGalleryTab}" 
                                      ItemsSource="{Binding Gallery}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="180" CornerRadius="0" Margin="0,0,16,16" ClipToBounds="True">
                                        <Image helpers:ImageAsyncHelper.SourceUrl="{Binding}" Stretch="Uniform"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Versions Tab -->
                        <ItemsControl IsVisible="{Binding IsVersionsTab}" 
                                      ItemsSource="{Binding Versions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" CornerRadius="0" Padding="16" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding VersionNumber}" FontSize="12" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource Lang_Versions_InstallBtn}" Command="{Binding $parent[UserControl].((vm:ModDetailPageViewModel)DataContext).InstallVersionCommand}" CommandParameter="{Binding}" Classes="piece primary" Background="{DynamicResource PieceOrangeFaceBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </StackPanel>

                <!-- Right Content: Install Floating Panel & Metadata -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2" CornerRadius="0" Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource PieceOrangeFaceBrush}" TextWrapping="Wrap"/>
                            <Button Content="{DynamicResource Lang_Versions_InstallBtn}" Command="{Binding InstallLatestCommand}" HorizontalAlignment="Stretch" Classes="piece primary" Background="{DynamicResource PieceOrangeFaceBrush}"/>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Lang_Global_Downloads}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Project.Downloads, Converter={StaticResource CompactDownloadCountConverter}}" FontWeight="SemiBold" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding HasSupportedLoaders}">
                                <TextBlock Text="{DynamicResource Lang_ModDetail_SupportedLoaders}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SupportedLoadersText}" FontWeight="SemiBold" Foreground="{DynamicResource PieceTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Lang_Global_License}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Project.License}" FontWeight="SemiBold" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
