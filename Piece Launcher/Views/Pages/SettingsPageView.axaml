<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             xmlns:models="using:Piece_Launcher.Models"
             x:Class="Piece_Launcher.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <Grid ColumnDefinitions="*,210">
        <ScrollViewer x:Name="SettingsScroll" Grid.Column="0" Padding="4,4,20,4"
                      VerticalScrollBarVisibility="Auto" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel x:Name="SectionContent" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Lang_Settings_Title}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource PieceTextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_Subtitle}" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                </StackPanel>

                <Border x:Name="GeneralSection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_General}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_StartupPage}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableStartupPages}" SelectedItem="{Binding SelectedStartupPage, Mode=TwoWay}"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Lang_Settings_LaunchStartup}" IsChecked="{Binding Config.LaunchOnStartup, Mode=TwoWay}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_KeepOpen}" IsChecked="{Binding Config.KeepOpenWhilePlaying, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="AppearanceSection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_Appearance}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Lang_Settings_Language}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding Config.Language, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang_Settings_Theme}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="GameSection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_Game}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_AutoDetectJava}" IsChecked="{Binding Config.AutoDetectJava, Mode=TwoWay}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_JavaPath}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Config.DefaultJava, Mode=TwoWay}" IsEnabled="{Binding !Config.AutoDetectJava}"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_JavaArguments}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Config.JavaArguments, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_GameDirectory}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding GameDirectory}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="{DynamicResource Lang_Settings_OpenFolder}" Classes="piece"
                                        Command="{Binding OpenGameDirectoryCommand}"/>
                            </Grid>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Lang_Settings_MinimizeToTray}"
                                  IsChecked="{Binding Config.MinimizeToTray, Mode=TwoWay}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_MinecraftConsole}"
                                  IsChecked="{Binding Config.ShowMinecraftConsole, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MemorySection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_Memory}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_AutoRam}" IsChecked="{Binding Config.AutoRam, Mode=TwoWay}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_AutoRamDescription}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Lang_Settings_CustomRam}" Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Config.CustomRamGb, StringFormat='{}{0} GB'}" Foreground="{DynamicResource PieceTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="{Binding MaxCustomRamGb}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Config.CustomRamGb, Mode=TwoWay}" IsEnabled="{Binding !Config.AutoRam}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_SafeModeLimit}" IsChecked="{Binding Config.SafeModeLimit, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="VersionsSection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_Versions}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <CheckBox Content="{DynamicResource Lang_Versions_Snapshots}" IsChecked="{Binding Config.ShowSnapshots, Mode=TwoWay}"/>
                        <CheckBox Content="{DynamicResource Lang_Versions_Betas}" IsChecked="{Binding Config.ShowBetas, Mode=TwoWay}"/>
                        <CheckBox Content="{DynamicResource Lang_Versions_Alphas}" IsChecked="{Binding Config.ShowAlphas, Mode=TwoWay}"/>
                        <CheckBox Content="{DynamicResource Lang_Versions_OldVersions}" IsChecked="{Binding Config.ShowOldVersions, Mode=TwoWay}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_DefaultLoader}" FontSize="11" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableDefaultLoaders}" SelectedItem="{Binding Config.DefaultLoader, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ImporterSection" Classes="SectionCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang_Settings_Importer}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_ImporterDescription}"
                                   Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{DynamicResource Lang_Settings_FindLaunchers}"
                                    Classes="piece"
                                    Command="{Binding DiscoverLauncherInstallsCommand}"
                                    IsEnabled="{Binding !IsImportingLauncherData}"/>
                            <Button Content="{DynamicResource Lang_Settings_BrowseLauncherFolder}"
                                    Classes="piece"
                                    Click="OnBrowseImportFolderClick"
                                    IsEnabled="{Binding !IsImportingLauncherData}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ImportSources}"
                                 Height="150"
                                 SelectionMode="Multiple"
                                 SelectionChanged="OnImportSourcesSelectionChanged"
                                 IsVisible="{Binding HasImportSources}"
                                 IsEnabled="{Binding !IsImportingLauncherData}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LauncherImportSource">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource PieceTextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GameDirectory}"
                                                   Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding HasImportSources}">
                            <Button Content="{DynamicResource Lang_Settings_ImportSelected}"
                                    Classes="piece primary"
                                    Command="{Binding ImportSelectedLauncherDataCommand}"
                                    IsEnabled="{Binding HasSelectedImportSources}"/>
                            <Button Content="{DynamicResource Lang_Settings_ImportAll}"
                                    Classes="piece"
                                    Command="{Binding ImportAllLauncherDataCommand}"
                                    IsEnabled="{Binding !IsImportingLauncherData}"/>
                        </StackPanel>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding LauncherImportProgress}"
                                     IsVisible="{Binding IsImportingLauncherData}"/>
                        <TextBlock Text="{Binding LauncherImportStatus}"
                                   Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding LauncherImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="UpdatesSection" Classes="SectionCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Lang_Settings_Updates}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <CheckBox Content="{DynamicResource Lang_Settings_AutomaticUpdates}" IsChecked="{Binding Config.CheckLauncherUpdates, Mode=TwoWay}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_UpdatesDescription}" Foreground="{DynamicResource PieceTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_UpdatesRequireInstall}" Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   TextWrapping="Wrap" IsVisible="{Binding !IsUpdaterInstalled}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_CheckingForUpdates}" Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   IsVisible="{Binding IsCheckingForUpdates}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_UpToDate}" Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   IsVisible="{Binding IsUpToDate}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasUpdate}">
                            <TextBlock Text="{DynamicResource Lang_Settings_UpdateAvailable}" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AvailableUpdateVersion}" Foreground="{DynamicResource PieceTextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Lang_Settings_DownloadingUpdate}" Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   IsVisible="{Binding IsDownloadingUpdate}"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress}"
                                     IsVisible="{Binding IsDownloadingUpdate}"/>
                        <StackPanel IsVisible="{Binding HasUpdateCheckFailed}" Spacing="4">
                            <TextBlock Text="{DynamicResource Lang_Settings_UpdateFailed}" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding UpdateError}" Foreground="{DynamicResource PieceTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{DynamicResource Lang_Settings_CheckForUpdates}" Padding="14,8" Classes="piece"
                                    Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsUpdaterInstalled}"/>
                            <Button Content="{DynamicResource Lang_Settings_DownloadUpdate}" Padding="14,8" Classes="piece primary"
                                    Command="{Binding DownloadAndInstallUpdateCommand}" IsVisible="{Binding HasUpdate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutSection" Classes="SectionCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Lang_Settings_About}" Classes="SectionLabel"/>
                        <Border Height="1" Background="{DynamicResource ThemeChromeBorderBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Lang_Settings_Version}" Foreground="{DynamicResource PieceTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LauncherVersion}" Foreground="{DynamicResource PieceTextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Lang_Settings_GitHub}" Classes="piece" Margin="0,0,8,8"
                                    Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://github.com/luaukrodev/Piece-Launcher"/>
                            <Button Content="{DynamicResource Lang_Settings_Releases}" Classes="piece" Margin="0,0,8,8"
                                    Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://github.com/luaukrodev/Piece-Launcher/releases"/>
                            <Button Content="{DynamicResource Lang_Settings_License}" Classes="piece" Margin="0,0,8,8"
                                    Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://github.com/luaukrodev/Piece-Launcher/blob/master/LICENSE.txt"/>
                        </WrapPanel>
                        <Button Content="{DynamicResource Lang_Settings_OpenDataFolder}" Classes="piece"
                                HorizontalAlignment="Left" Command="{Binding OpenLauncherDataDirectoryCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding SettingsError}" Foreground="{DynamicResource PieceTextSecondaryBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SettingsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Lang_Settings_Reset}" Padding="16,10" Classes="piece"
                            Command="{Binding ResetToDefaultsCommand}"/>
                    <Button Content="{DynamicResource Lang_Settings_Save}" Padding="20,10" Classes="piece primary"
                            Command="{Binding SaveSettingsCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="SettingsNavPanel" Margin="0,24,20,24" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Lang_Settings_Sections}" Classes="SettingsNavTitle"/>
                <Button x:Name="GeneralNavItem" Classes="piece SettingsNavItem active" Tag="General" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⚙"/><TextBlock Text="{DynamicResource Lang_Settings_General}"/></StackPanel>
                </Button>
                <Button x:Name="AppearanceNavItem" Classes="piece SettingsNavItem" Tag="Appearance" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◐"/><TextBlock Text="{DynamicResource Lang_Settings_Appearance}"/></StackPanel>
                </Button>
                <Button x:Name="GameNavItem" Classes="piece SettingsNavItem" Tag="Game" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⌂"/><TextBlock Text="{DynamicResource Lang_Settings_Game}"/></StackPanel>
                </Button>
                <Button x:Name="MemoryNavItem" Classes="piece SettingsNavItem" Tag="Memory" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▤"/><TextBlock Text="{DynamicResource Lang_Settings_Memory}"/></StackPanel>
                </Button>
                <Button x:Name="VersionsNavItem" Classes="piece SettingsNavItem" Tag="Versions" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◷"/><TextBlock Text="{DynamicResource Lang_Settings_Versions}"/></StackPanel>
                </Button>
                <Button x:Name="ImporterNavItem" Classes="piece SettingsNavItem" Tag="Importer" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⇩"/><TextBlock Text="{DynamicResource Lang_Settings_Importer}"/></StackPanel>
                </Button>
                <Button x:Name="UpdatesNavItem" Classes="piece SettingsNavItem" Tag="Updates" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="↻"/><TextBlock Text="{DynamicResource Lang_Settings_Updates}"/></StackPanel>
                </Button>
                <Button x:Name="AboutNavItem" Classes="piece SettingsNavItem" Tag="About" Click="OnSectionNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="ⓘ"/><TextBlock Text="{DynamicResource Lang_Settings_About}"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
