<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             x:Class="Piece_Launcher.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer Margin="44,12,44,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Lang_Settings_Title}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{DynamicResource Lang_Settings_Subtitle}" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <!-- ─── GENERAL SETTINGS ─── -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Lang_Settings_General}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

                    <!-- Appearance Options -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Lang_Settings_Language}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding Config.Language, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{DynamicResource Lang_Settings_Theme}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding Config.Theme, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Lang_Settings_StartupPage}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <ComboBox ItemsSource="{Binding AvailableStartupPages}" SelectedItem="{Binding Config.StartupPage, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Behavior Options -->
                    <Border Height="1" Background="{DynamicResource SurfaceDivider}"/>
                    <CheckBox Content="{DynamicResource Lang_Settings_LaunchStartup}" IsChecked="{Binding Config.LaunchOnStartup, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Lang_Settings_AutomaticUpdates}" IsChecked="{Binding Config.CheckLauncherUpdates, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Lang_Settings_KeepOpen}" IsChecked="{Binding Config.KeepOpenWhilePlaying, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource Lang_Settings_Updates}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_UpdatesDescription}"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_UpdatesRequireInstall}"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               IsVisible="{Binding !IsUpdaterInstalled}"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_CheckingForUpdates}"
                               Foreground="{DynamicResource TextMuted}"
                               IsVisible="{Binding IsCheckingForUpdates}"/>
                    <TextBlock Text="{DynamicResource Lang_Settings_UpToDate}"
                               Foreground="{DynamicResource TextMuted}"
                               IsVisible="{Binding IsUpToDate}"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasUpdate}">
                        <TextBlock Text="{DynamicResource Lang_Settings_UpdateAvailable}"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding AvailableUpdateVersion}"
                                   Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Lang_Settings_DownloadingUpdate}"
                               Foreground="{DynamicResource TextMuted}"
                               IsVisible="{Binding IsDownloadingUpdate}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress}"
                                 IsVisible="{Binding IsDownloadingUpdate}"/>
                    <StackPanel IsVisible="{Binding HasUpdateCheckFailed}" Spacing="4">
                        <TextBlock Text="{DynamicResource Lang_Settings_UpdateFailed}"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding UpdateError}" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{DynamicResource Lang_Settings_CheckForUpdates}"
                                Padding="14,8" Classes="MicrosoftButton"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsUpdaterInstalled}"/>
                        <Button Content="{DynamicResource Lang_Settings_DownloadUpdate}"
                                Padding="14,8" Classes="PlayButton"
                                Command="{Binding DownloadAndInstallUpdateCommand}"
                                IsVisible="{Binding HasUpdate}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource Lang_Settings_Version}"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="{Binding LauncherVersion}"
                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="{DynamicResource Lang_Settings_Reset}" Padding="16,10" Classes="MicrosoftButton" Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="{DynamicResource Lang_Settings_Save}" Padding="20,10" Classes="PlayButton" Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
