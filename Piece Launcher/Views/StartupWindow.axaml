<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Piece_Launcher.ViewModels"
        xmlns:controls="using:Piece_Launcher.Controls"
        x:Class="Piece_Launcher.Views.StartupWindow"
        x:DataType="vm:StartupWindowViewModel"
        Icon="/Assets/Piece Launcher.ico"
        Title="Piece Launcher"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="Transparent"
        CornerRadius="0">

    <Grid Background="Transparent">
        <Border BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="2"
                Background="{DynamicResource ThemeWindowBackgroundBrush}"
                Width="520"
                Height="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !IsTransitioning}">
            <Grid RowDefinitions="36,*">
            <!-- Mini Custom Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
                  Background="{DynamicResource ThemeTopBarBackgroundBrush}"
                  PointerPressed="OnTitlePointerPressed"
                  Margin="12,0,8,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="/Assets/Piece Launcher.png" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Piece Launcher" FontSize="12" Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent"/>

                <Button Grid.Column="2" Classes="win-btn close" Width="24" Height="24" ToolTip.Tip="{DynamicResource Lang_Global_Close}" Click="OnCloseClick" VerticalAlignment="Center">
                    <Path Width="10" Height="10" Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource PieceTextPrimaryBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24,16,24,16">
                <Grid ColumnDefinitions="96,*"
                      ColumnSpacing="20"
                      Width="448"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsMinecraftInstallProgressVisible}">
                    <controls:HatSpinner Grid.Column="0"
                                         Width="88"
                                         Height="88"
                                         VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PieceTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MinecraftInstallProgressText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding MinecraftInstallProgress}"
                                     Height="10"/>
                        <TextBlock Text="{Binding MinecraftInstallProgress, StringFormat='{}{0:F0}%'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PieceOrangeFaceBorderBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="14"
                            Width="440"
                            IsVisible="{Binding !IsMinecraftInstallProgressVisible}">
                    <!-- Hat Spinner (96px) -->
                    <controls:HatSpinner Width="96" Height="96"
                                         HorizontalAlignment="Center"
                                         IsVisible="{Binding IsSpinnerVisible}"/>

                    <!-- Title & Status -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PieceTextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Downloading Progress Bar (sharp, 8px tall, track #040515, border 1px #161954, fill orange) -->
                    <Border IsVisible="{Binding IsProgressBarVisible}"
                            Height="10"
                            Background="{DynamicResource PieceBlueBaseBrush}"
                            BorderBrush="{DynamicResource ThemeChromeBorderBrush}"
                            BorderThickness="1"
                            Padding="1"
                            HorizontalAlignment="Stretch">
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8"
                                     Foreground="{DynamicResource PieceOrangeFaceBrush}"
                                     Background="Transparent"
                                     BorderThickness="0" CornerRadius="0"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding IsUpdateConfirmationVisible}">
                        <Button Content="{DynamicResource Lang_Startup_UpdateNow}"
                                Height="44"
                                Padding="14,0"
                                Classes="piece primary"
                                Command="{Binding InstallUpdateCommand}"/>
                        <Button Content="{DynamicResource Lang_Startup_UpdateLater}"
                                Height="44"
                                Padding="14,0"
                                Classes="piece"
                                Command="{Binding ContinueWithoutUpdateCommand}"/>
                    </StackPanel>

                    <StackPanel Spacing="10"
                                IsVisible="{Binding IsProfileSetupVisible}">
                        <TextBox Text="{Binding NewProfileName, Mode=TwoWay}"
                                 PlaceholderText="{DynamicResource Lang_Startup_ProfileName}"
                                 HorizontalAlignment="Stretch"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="{DynamicResource Lang_Startup_CreateOfflineProfile}"
                                    Height="44"
                                    Padding="12,0"
                                    Margin="0,0,8,8"
                                    Classes="piece primary"
                                    Command="{Binding AddOfflineProfileCommand}"/>
                            <Button Content="{DynamicResource Lang_Profiles_SignInMs}"
                                    Height="44"
                                    Padding="12,0"
                                    Margin="0,0,8,8"
                                    Classes="piece"
                                    Command="{Binding SignInMicrosoftCommand}"/>
                            <Button Content="{DynamicResource Lang_Startup_SkipProfileSetup}"
                                    Height="44"
                                    Padding="12,0"
                                    Margin="0,0,0,8"
                                    Classes="piece"
                                    Command="{Binding SkipProfileSetupCommand}"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding IsSetupFailureVisible}">
                        <Button Content="{DynamicResource Lang_Startup_RetrySetup}"
                                Height="44"
                                Padding="14,0"
                                Classes="piece primary"
                                Command="{Binding RetrySetupCommand}"/>
                        <Button Content="{DynamicResource Lang_Startup_ContinueSetup}"
                                Height="44"
                                Padding="14,0"
                                Classes="piece"
                                Command="{Binding ContinueWithoutSetupCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
            </Grid>
        </Border>

        <Border Width="{Binding TransitionWidth}"
                Height="{Binding TransitionHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF383838"
                Opacity="{Binding TransitionOpacity}"
                IsVisible="{Binding IsTransitioning}"
                IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.420" Easing="{StaticResource PieceEaseInOut}"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.420" Easing="{StaticResource PieceEaseInOut}"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.240" Easing="{StaticResource PieceEaseInOut}"/>
                </Transitions>
            </Border.Transitions>
            <controls:HatSpinner Width="160"
                                 Height="160"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
