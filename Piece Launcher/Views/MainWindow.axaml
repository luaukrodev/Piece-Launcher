<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Piece_Launcher.ViewModels"
        xmlns:controls="using:Piece_Launcher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Piece_Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Piece Launcher.ico"
        Title="Piece Launcher"
        Width="1280" Height="720"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        CornerRadius="0">

    <Grid RowDefinitions="44,*">
        <!-- ═══════════════ TOP BAR (WINDOW DECORATIONS) ═══════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeTopBarBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,14,0">
                <!-- Left: Hat Icon (26x26) + Title Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="/Assets/Piece Launcher.png" Width="26" Height="26" VerticalAlignment="Center"/>
                    <TextBlock Text="Piece Launcher" FontSize="13" Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Draggable Spacer -->
                <Border Grid.Column="1" Background="Transparent" />

                <!-- Right: Window Control Buttons (30x30, 6px apart) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="win-btn min-max" ToolTip.Tip="{DynamicResource Lang_Global_Minimize}" Click="OnMinimizeClick">
                        <Path Width="14" Height="14" Data="M1,7 L13,7" Stroke="{DynamicResource PieceTextPrimaryBrush}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="win-btn min-max" ToolTip.Tip="{DynamicResource Lang_Global_MaximizeRestore}" Click="OnMaximizeClick">
                        <Path Width="14" Height="14" Data="M2,2 L12,2 L12,12 L2,12 Z" Stroke="{DynamicResource PieceTextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="win-btn close" ToolTip.Tip="{DynamicResource Lang_Global_Close}" Click="OnCloseClick">
                        <Path Width="14" Height="14" Data="M2,2 L12,12 M12,2 L2,12" Stroke="{DynamicResource PieceTextPrimaryBrush}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ BODY (SIDEBAR + MAIN AREA) ═══════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*">
            <!-- ════ SIDEBAR ════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThemeSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeChromeBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="12,16,12,16">
                    <!-- Top: Brand Block -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,0,0,0">
                            <!-- Hat Logo 56x56 -->
                            <Image Grid.Column="0" Source="/Assets/Piece Launcher.png" Width="56" Height="56" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                                <TextBlock Text="PIECE" FontSize="20" FontWeight="Black"
                                           Foreground="{DynamicResource PieceOrangeFaceBorderBrush}" LetterSpacing="4"/>
                                <TextBlock Text="LAUNCHER" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextSecondaryBrush}" LetterSpacing="3"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Nav List (Buttons 234px wide, 10px gap) -->
                    <StackPanel Grid.Row="1" Spacing="10">
                        <!-- 1. Minecraft: Java Edition -->
                        <Button Classes="piece nav" Classes.active="{Binding IsJavaEditionActive}"
                                Command="{Binding NavigateJavaEditionCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M3,10 L12,3 L21,10 L21,20 L15,20 L15,13 L9,13 L9,20 L3,20 Z"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_JavaEdition}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 2. Profiles -->
                        <Button Classes="piece nav" Classes.active="{Binding IsProfilesActive}"
                                Command="{Binding NavigateProfilesCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4 M4,20 C4,16 8,15 12,15 C16,15 20,16 20,20"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_Profiles}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 3. Versions -->
                        <Button Classes="piece nav" Classes.active="{Binding IsVersionsActive}"
                                Command="{Binding NavigateVersionsCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M4,4 L12,4 L12,12 L4,12 Z M12,12 L20,12 L20,20 L12,20 Z M4,14 L10,14 M14,6 L20,6"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_Versions}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 4. Minecraft Mods -->
                        <Button Classes="piece nav" Classes.active="{Binding IsMinecraftModsActive}"
                                Command="{Binding NavigateMinecraftModsCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M13,2 L4,13 L11,13 L10,22 L20,10 L13,10 Z"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_MinecraftMods}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 5. Community -->
                        <Button Classes="piece nav" Classes.active="{Binding IsCommunityActive}"
                                Command="{Binding NavigateCommunityCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M12,2 L21,8 L21,16 L12,22 L3,16 L3,8 Z"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_Community}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom pinned: 2px divider, 14px gap, Configurations button, Version label -->
                    <StackPanel Grid.Row="2" Spacing="14">
                        <Border Height="2" Background="{DynamicResource ThemeChromeBorderBrush}" />

                        <!-- Configurations (Settings) Button -->
                        <Button Classes="piece nav" Classes.active="{Binding IsSettingsActive}"
                                Command="{Binding NavigateSettingsCommand}" Width="234">
                            <Grid ColumnDefinitions="48,*">
                                <Path Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Margin="16,0,0,0"
                                      Data="M12,15 C10.34,15 9,13.66 9,12 C9,10.34 10.34,9 12,9 C13.66,9 15,10.34 15,12 C15,13.66 13.66,15 12,15 Z M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.97 19.05,5.05 L16.56,6.05 C16.04,5.65 15.48,5.32 14.87,5.07 L14.49,2.42 C14.46,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.51,2.42 L9.13,5.07 C8.52,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.72,19.03 4.95,18.95 L7.44,17.95 C7.96,18.35 8.52,18.68 9.13,18.93 L9.51,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.49,21.58 L14.87,18.93 C15.48,18.68 16.04,18.34 16.56,17.95 L19.05,18.95 C19.28,19.04 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.97 Z"
                                      Stroke="{DynamicResource PieceTextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang_Nav_Settings}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Version Label -->
                        <TextBlock Text="{Binding FormattedLauncherVersion}"
                                   FontSize="12" Foreground="{DynamicResource PieceTextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════ MAIN AREA (PADDING 32) ════ -->
            <Grid Grid.Column="1">
                <Border Background="{DynamicResource ThemeWindowBackgroundBrush}" Padding="32">
                    <TransitioningContentControl Content="{Binding CurrentPage}">
                        <TransitioningContentControl.PageTransition>
                            <PageSlide Duration="0:0:0.220" Orientation="Vertical" />
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>
                </Border>

                <!-- ════ REUSABLE UNIVERSAL LOADING OVERLAY (MAIN AREA ONLY) ════ -->
                <Border Background="{DynamicResource ThemeLoadingOverlayBrush}"
                        IsVisible="{Binding IsDefaultLoadingSpinnerVisible}"
                        Opacity="{Binding LoadingOverlayOpacity}"
                        IsHitTestVisible="{Binding IsDefaultLoadingSpinnerVisible}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.250" Easing="{StaticResource PieceEaseInOut}" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:HatSpinner Width="96" Height="96"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding IsDefaultLoadingSpinnerVisible}" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsVersionInstallProgressVisible}"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="2"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,480" ColumnSpacing="16">
                        <controls:HatSpinner Grid.Column="0" Width="48" Height="48"
                                             VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding VersionInstallProgressText}"
                                           Foreground="{DynamicResource PieceTextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding VersionInstallProgressValue, StringFormat='{}{0:F0}%'}"
                                           Foreground="{DynamicResource PieceOrangeFaceBorderBrush}"
                                           FontSize="13" FontWeight="Bold" />
                            </Grid>
                            <ProgressBar Value="{Binding VersionInstallProgressValue}" Maximum="100"
                                         Height="8" Foreground="{DynamicResource PieceOrangeFaceBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ════ STARTUP COVER (COVERS SIDEBAR & MAIN, FADES OUT 800ms) ════ -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Background="#FF383838"
              IsVisible="{Binding IsStartupCoverVisible}"
              Opacity="{Binding StartupCoverOpacity}">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource PieceMotionCoverFade}" Easing="{StaticResource PieceEaseInOut}" />
                </Transitions>
            </Grid.Transitions>
            <controls:HatSpinner Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding IsStartupCoverVisible}" />
        </Grid>
    </Grid>
</Window>
