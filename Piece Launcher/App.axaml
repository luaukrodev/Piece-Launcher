<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Piece_Launcher.App"
             xmlns:pages="using:Piece_Launcher.Views.Pages"
             xmlns:vm="using:Piece_Launcher.ViewModels.Pages"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:JavaEditionPageViewModel">
            <pages:JavaEditionPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesPageViewModel">
            <pages:ProfilesPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfileManagementPageViewModel">
            <pages:ProfileManagementPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:VersionsPageViewModel">
            <pages:VersionsPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:MinecraftModsPageViewModel">
            <pages:MinecraftModsPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:CommunityPageViewModel">
            <pages:CommunityPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsPageViewModel">
            <pages:SettingsPageView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Piece%20Launcher/Styles/PieceTokens.axaml" />
                <!-- The selected theme follows the defaults so it can override every color token. -->
                <ResourceInclude Source="avares://Piece%20Launcher/Themes/DarkOrangeTheme.axaml" />
                <ResourceInclude Source="avares://Piece%20Launcher/Styles/PieceMotion.axaml" />
                <ResourceInclude Source="avares://Piece%20Launcher/Langs/English.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ═══ SIDEBAR BUTTON ═══ -->
        <!-- ═══ PLAY BUTTON ═══ -->
        <!-- ═══ MICROSOFT BUTTON ═══ -->
        <!-- ═══ REMOVE BUTTON (profile cards) ═══ -->
        <!-- ═══ WINDOW CONTROL BUTTONS ═══ -->
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style Selector="TextBlock.SectionLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PieceTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.SettingsNavPanel">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBlock.SettingsNavTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PieceTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="8,4,8,6"/>
        </Style>
        <Style Selector="Button.SettingsNavItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PieceTextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <StyleInclude Source="avares://Piece%20Launcher/Styles/PieceTheme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Piece Launcher.ico" ToolTipText="Piece Launcher" IsVisible="False">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{DynamicResource Lang_Tray_Open}" />
                        <NativeMenuItem Header="{DynamicResource Lang_Tray_Exit}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
