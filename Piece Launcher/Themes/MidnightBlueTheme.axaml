<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ BASE COLORS (MIDNIGHT BLUE) ═══ -->
    <Color x:Key="WindowBgColor">#08111F</Color>
    <Color x:Key="SidebarBgColor">#050B14</Color>
    <Color x:Key="CardBgColor">#0F1B2D</Color>
    <Color x:Key="InnerCardBgColor">#0B1524</Color>
    
    <Color x:Key="AccentColor">#58A6FF</Color>
    <Color x:Key="AccentPillColor">#58A6FF</Color>
    <Color x:Key="SystemAccentColor">#58A6FF</Color>
    <Color x:Key="SystemAccentColorDark1">#3478E5</Color>

    <!-- ═══ TEXT COLORS ═══ -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C2D5EA" />
    <SolidColorBrush x:Key="TextMuted" Color="#9EB4D0" />
    <SolidColorBrush x:Key="TextDimmed" Color="#8298B6" />
    <SolidColorBrush x:Key="TextVeryDimmed" Color="#667C9A" />
    <SolidColorBrush x:Key="TextLabel" Color="#7DA5D6" />
    <SolidColorBrush x:Key="TextError" Color="#ff5252" />
    <SolidColorBrush x:Key="TextWatermark" Color="#08111F" />

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#3478E5" />
    
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SecondaryBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#213552" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#213552" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#15243A" />
    <SolidColorBrush x:Key="SidebarLogoBg" Color="#132139" />

    <!-- Sidebar Navigation -->
    <SolidColorBrush x:Key="SidebarHoverBg" Color="#192B46" />
    <SolidColorBrush x:Key="SidebarHoverText" Color="#ffffff" />
    <SolidColorBrush x:Key="SidebarPressedBg" Color="#132139" />
    <SolidColorBrush x:Key="SidebarActiveBg" Color="#203654" />
    <SolidColorBrush x:Key="SidebarActiveText" Color="{StaticResource AccentColor}" />

    <!-- Cards & Surfaces -->
    <SolidColorBrush x:Key="ElevatedBackground" Color="#14243C" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="InnerCardBackground" Color="{StaticResource InnerCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E3452" />
    <SolidColorBrush x:Key="SurfaceDivider" Color="#29466D" />

    <!-- Launch Bar -->
    <SolidColorBrush x:Key="LaunchBarBackground" Color="#070F1C" />
    <SolidColorBrush x:Key="LaunchBarBorderBrush" Color="#182B45" />
    <SolidColorBrush x:Key="LaunchBarInnerBg" Color="#132139" />
    <SolidColorBrush x:Key="LaunchBarInnerBorder" Color="#1C304D" />

    <!-- Badges & Pills -->
    <Color x:Key="AccentPillBgColor">#58A6FF</Color>
    <SolidColorBrush x:Key="AccentPillBorder" Color="#24508A" />
    
    <SolidColorBrush x:Key="BadgeTypeBg" Color="#142A46" />
    <SolidColorBrush x:Key="BadgeTypeFg" Color="#58A6FF" />

    <!-- ═══ BUTTONS ═══ -->
    <!-- Play Button Gradient -->
    <Color x:Key="PlayBtnTop">#2F6FBF</Color>
    <Color x:Key="PlayBtnBottom">#244F9E</Color>
    <Color x:Key="PlayBtnHoverTop">#2F6FBF</Color>
    <Color x:Key="PlayBtnHoverBottom">#244F9E</Color>
    <Color x:Key="PlayBtnPressedTop">#2866C7</Color>
    <Color x:Key="PlayBtnPressedBottom">#244F9E</Color>

    <!-- Microsoft Button -->
    <SolidColorBrush x:Key="MicrosoftBtnBg" Color="#ffffff" />
    <SolidColorBrush x:Key="MicrosoftBtnFg" Color="#222222" />
    <SolidColorBrush x:Key="MicrosoftBtnBorder" Color="#cccccc" />
    <SolidColorBrush x:Key="MicrosoftBtnHoverBg" Color="#e6e6e6" />

    <!-- Remove Button -->
    <SolidColorBrush x:Key="RemoveHoverBg" Color="#223B5C" />
    <SolidColorBrush x:Key="RemoveHoverFg" Color="#ff5252" />

    <!-- Windows Control Buttons -->
    <SolidColorBrush x:Key="WinBtnBg" Color="Transparent" />
    <SolidColorBrush x:Key="WinBtnFg" Color="#8298B6" />
    <SolidColorBrush x:Key="WinCloseBg" Color="#DC3545" />
    <SolidColorBrush x:Key="WinMaxBg" Color="#29466D" />
    <SolidColorBrush x:Key="WinMinBg" Color="#29466D" />

    <!-- ═══ GLOWS ═══ -->
    <Color x:Key="GlowPrimary">#1058A6FF</Color>
    <Color x:Key="GlowSecondary">#0824508A</Color>

    <x:Boolean x:Key="IsDarkTheme">True</x:Boolean>
    <Color x:Key="PieceWindowBackground">#08111F</Color>
    <Color x:Key="PieceTopBarBackground">#070F1C</Color>
    <Color x:Key="PieceSidebarBackground">#050B14</Color>
    <Color x:Key="PieceChromeBorder">#213552</Color>
    <Color x:Key="PieceWindowControlButtonBackground">#132139</Color>
    <Color x:Key="PieceBlueFaceTop">#0F1B2D</Color>
    <Color x:Key="PieceBlueFaceBottom">#14243C</Color>
    <Color x:Key="PieceBlueFaceBorder">#1E3452</Color>
    <Color x:Key="PieceBlueBase">#08111F</Color>
    <Color x:Key="PieceBlueHoverTop">#192B46</Color>
    <Color x:Key="PieceBlueHoverBottom">#203654</Color>
    <Color x:Key="PieceBlueHoverBorder">#29466D</Color>
    <Color x:Key="PieceOrangeFaceTop">#2F6FBF</Color>
    <Color x:Key="PieceOrangeFaceBottom">#244F9E</Color>
    <Color x:Key="PieceOrangeFaceBorder">#79C0FF</Color>
    <Color x:Key="PieceOrangeBase">#142A46</Color>
    <Color x:Key="PieceOrangeHoverTop">#2F6FBF</Color>
    <Color x:Key="PieceOrangeHoverBottom">#244F9E</Color>
    <Color x:Key="PieceOrangeHoverBorder">#66f2ff</Color>
    <Color x:Key="PieceCardBackground">#0F1B2D</Color>
    <Color x:Key="PieceCardBorder">#1E3452</Color>
    <Color x:Key="PieceTextPrimary">#FFFFFF</Color>
    <Color x:Key="PieceTextSecondary">#C2D5EA</Color>
    <Color x:Key="PieceKeyboardFocus">#58A6FF</Color>
    <SolidColorBrush x:Key="PieceWindowBackgroundBrush" Color="#08111F" />
    <SolidColorBrush x:Key="PieceTopBarBackgroundBrush" Color="#070F1C" />
    <SolidColorBrush x:Key="PieceSidebarBackgroundBrush" Color="#050B14" />
    <SolidColorBrush x:Key="PieceChromeBorderBrush" Color="#213552" />
    <SolidColorBrush x:Key="PieceWindowControlButtonBackgroundBrush" Color="#132139" />
    <SolidColorBrush x:Key="PieceCardBackgroundBrush" Color="#0F1B2D" />
    <SolidColorBrush x:Key="PieceCardBorderBrush" Color="#1E3452" />
    <SolidColorBrush x:Key="PieceTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PieceTextSecondaryBrush" Color="#C2D5EA" />
    <SolidColorBrush x:Key="PieceLoadingOverlayBrush" Color="#E6050a14" />
    <SolidColorBrush x:Key="PieceKeyboardFocusBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="PieceBlueFaceBorderBrush" Color="#1E3452" />
    <SolidColorBrush x:Key="PieceBlueHoverBorderBrush" Color="#29466D" />
    <SolidColorBrush x:Key="PieceBlueBaseBrush" Color="#08111F" />
    <SolidColorBrush x:Key="PieceOrangeFaceBorderBrush" Color="#79C0FF" />
    <SolidColorBrush x:Key="PieceOrangeHoverBorderBrush" Color="#66f2ff" />
    <SolidColorBrush x:Key="PieceOrangeBaseBrush" Color="#142A46" />
    <LinearGradientBrush x:Key="PieceBlueFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1B2D" Offset="0" /><GradientStop Color="#14243C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceBlueHoverFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#192B46" Offset="0" /><GradientStop Color="#203654" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceOrangeFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F6FBF" Offset="0" /><GradientStop Color="#244F9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceOrangeHoverFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F6FBF" Offset="0" /><GradientStop Color="#244F9E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#08111F" />
    <SolidColorBrush x:Key="ThemeTopBarBackgroundBrush" Color="#070F1C" />
    <SolidColorBrush x:Key="ThemeSidebarBackgroundBrush" Color="#050B14" />
    <SolidColorBrush x:Key="ThemeChromeBorderBrush" Color="#213552" />
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#0F1B2D" />
    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#1E3452" />
    <SolidColorBrush x:Key="ThemeLoadingOverlayBrush" Color="#E6050a14" />

</ResourceDictionary>
