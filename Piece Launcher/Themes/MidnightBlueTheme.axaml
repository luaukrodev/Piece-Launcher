<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ BASE COLORS (MIDNIGHT BLUE) ═══ -->
    <Color x:Key="WindowBgColor">#050a14</Color>
    <Color x:Key="SidebarBgColor">#02060d</Color>
    <Color x:Key="CardBgColor">#0a1120</Color>
    <Color x:Key="InnerCardBgColor">#060c18</Color>
    
    <Color x:Key="AccentColor">#00e5ff</Color>
    <Color x:Key="AccentPillColor">#00e5ff</Color>

    <!-- ═══ TEXT COLORS ═══ -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff" />
    <SolidColorBrush x:Key="TextSecondary" Color="#b0c4de" />
    <SolidColorBrush x:Key="TextMuted" Color="#8a9ebf" />
    <SolidColorBrush x:Key="TextDimmed" Color="#667a99" />
    <SolidColorBrush x:Key="TextVeryDimmed" Color="#4b5d7a" />
    <SolidColorBrush x:Key="TextLabel" Color="#4a73b0" />
    <SolidColorBrush x:Key="TextError" Color="#ff5252" />
    <SolidColorBrush x:Key="TextWatermark" Color="#030b1c" />

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1a2740" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1a2740" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#0e1726" />
    <SolidColorBrush x:Key="SidebarLogoBg" Color="#0a1224" />

    <!-- Sidebar Navigation -->
    <SolidColorBrush x:Key="SidebarHoverBg" Color="#0f192b" />
    <SolidColorBrush x:Key="SidebarHoverText" Color="#ffffff" />
    <SolidColorBrush x:Key="SidebarPressedBg" Color="#0a1224" />
    <SolidColorBrush x:Key="SidebarActiveBg" Color="#121e33" />
    <SolidColorBrush x:Key="SidebarActiveText" Color="{StaticResource AccentColor}" />

    <!-- Cards & Surfaces -->
    <SolidColorBrush x:Key="ElevatedBackground" Color="#0c1629" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="InnerCardBackground" Color="{StaticResource InnerCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#122038" />
    <SolidColorBrush x:Key="SurfaceDivider" Color="#1a2b4a" />

    <!-- Launch Bar -->
    <SolidColorBrush x:Key="LaunchBarBackground" Color="#040812" />
    <SolidColorBrush x:Key="LaunchBarBorderBrush" Color="#101a2e" />
    <SolidColorBrush x:Key="LaunchBarInnerBg" Color="#0a1224" />
    <SolidColorBrush x:Key="LaunchBarInnerBorder" Color="#121e36" />

    <!-- Badges & Pills -->
    <Color x:Key="AccentPillBgColor">#00e5ff</Color>
    <SolidColorBrush x:Key="AccentPillBorder" Color="#006673" />
    
    <SolidColorBrush x:Key="BadgeTypeBg" Color="#0e1b33" />
    <SolidColorBrush x:Key="BadgeTypeFg" Color="#00e5ff" />

    <!-- ═══ BUTTONS ═══ -->
    <!-- Play Button Gradient -->
    <Color x:Key="PlayBtnTop">#00e5ff</Color>
    <Color x:Key="PlayBtnBottom">#0088ff</Color>
    <Color x:Key="PlayBtnHoverTop">#33edff</Color>
    <Color x:Key="PlayBtnHoverBottom">#0099ff</Color>
    <Color x:Key="PlayBtnPressedTop">#00b3cc</Color>
    <Color x:Key="PlayBtnPressedBottom">#006bb3</Color>

    <!-- Microsoft Button -->
    <SolidColorBrush x:Key="MicrosoftBtnBg" Color="#ffffff" />
    <SolidColorBrush x:Key="MicrosoftBtnFg" Color="#222222" />
    <SolidColorBrush x:Key="MicrosoftBtnBorder" Color="#cccccc" />
    <SolidColorBrush x:Key="MicrosoftBtnHoverBg" Color="#e6e6e6" />

    <!-- Remove Button -->
    <SolidColorBrush x:Key="RemoveHoverBg" Color="#1c2b45" />
    <SolidColorBrush x:Key="RemoveHoverFg" Color="#ff5252" />

    <!-- Windows Control Buttons -->
    <SolidColorBrush x:Key="WinBtnBg" Color="Transparent" />
    <SolidColorBrush x:Key="WinBtnFg" Color="#667a99" />
    <SolidColorBrush x:Key="WinCloseBg" Color="#e81123" />
    <SolidColorBrush x:Key="WinMaxBg" Color="#1a2b4a" />
    <SolidColorBrush x:Key="WinMinBg" Color="#1a2b4a" />

    <!-- ═══ GLOWS ═══ -->
    <Color x:Key="GlowPrimary">#1000b3cc</Color>
    <Color x:Key="GlowSecondary">#08006673</Color>

</ResourceDictionary>
