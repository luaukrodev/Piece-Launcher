<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ BASE COLORS (FOREST GREEN) ═══ -->
    <Color x:Key="WindowBgColor">#0a120e</Color>
    <Color x:Key="SidebarBgColor">#060a08</Color>
    <Color x:Key="CardBgColor">#101c15</Color>
    <Color x:Key="InnerCardBgColor">#0c1610</Color>
    
    <Color x:Key="AccentColor">#00e676</Color>
    <Color x:Key="AccentPillColor">#00e676</Color>

    <!-- ═══ TEXT COLORS ═══ -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff" />
    <SolidColorBrush x:Key="TextSecondary" Color="#c2d6cb" />
    <SolidColorBrush x:Key="TextMuted" Color="#99b3a4" />
    <SolidColorBrush x:Key="TextDimmed" Color="#738c7d" />
    <SolidColorBrush x:Key="TextVeryDimmed" Color="#54665b" />
    <SolidColorBrush x:Key="TextLabel" Color="#3d6b53" />
    <SolidColorBrush x:Key="TextError" Color="#ff5252" />
    <SolidColorBrush x:Key="TextWatermark" Color="#08140c" />

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1c3024" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14261c" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#0f1c14" />
    <SolidColorBrush x:Key="SidebarLogoBg" Color="#101f16" />

    <!-- Sidebar Navigation -->
    <SolidColorBrush x:Key="SidebarHoverBg" Color="#14261b" />
    <SolidColorBrush x:Key="SidebarHoverText" Color="#ffffff" />
    <SolidColorBrush x:Key="SidebarPressedBg" Color="#0d1c13" />
    <SolidColorBrush x:Key="SidebarActiveBg" Color="#183021" />
    <SolidColorBrush x:Key="SidebarActiveText" Color="{StaticResource AccentColor}" />

    <!-- Cards & Surfaces -->
    <SolidColorBrush x:Key="ElevatedBackground" Color="#14241a" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="InnerCardBackground" Color="{StaticResource InnerCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1e3627" />
    <SolidColorBrush x:Key="SurfaceDivider" Color="#223d2b" />

    <!-- Launch Bar -->
    <SolidColorBrush x:Key="LaunchBarBackground" Color="#080f0c" />
    <SolidColorBrush x:Key="LaunchBarBorderBrush" Color="#14261c" />
    <SolidColorBrush x:Key="LaunchBarInnerBg" Color="#122419" />
    <SolidColorBrush x:Key="LaunchBarInnerBorder" Color="#1b3624" />

    <!-- Badges & Pills -->
    <Color x:Key="AccentPillBgColor">#00e676</Color>
    <SolidColorBrush x:Key="AccentPillBorder" Color="#006634" />
    
    <SolidColorBrush x:Key="BadgeTypeBg" Color="#122e1e" />
    <SolidColorBrush x:Key="BadgeTypeFg" Color="#00e676" />

    <!-- ═══ BUTTONS ═══ -->
    <!-- Play Button Gradient -->
    <Color x:Key="PlayBtnTop">#00e676</Color>
    <Color x:Key="PlayBtnBottom">#00a656</Color>
    <Color x:Key="PlayBtnHoverTop">#33eb91</Color>
    <Color x:Key="PlayBtnHoverBottom">#00ba60</Color>
    <Color x:Key="PlayBtnPressedTop">#00b35c</Color>
    <Color x:Key="PlayBtnPressedBottom">#008042</Color>

    <!-- Microsoft Button -->
    <SolidColorBrush x:Key="MicrosoftBtnBg" Color="#ffffff" />
    <SolidColorBrush x:Key="MicrosoftBtnFg" Color="#222222" />
    <SolidColorBrush x:Key="MicrosoftBtnBorder" Color="#cccccc" />
    <SolidColorBrush x:Key="MicrosoftBtnHoverBg" Color="#e6e6e6" />

    <!-- Remove Button -->
    <SolidColorBrush x:Key="RemoveHoverBg" Color="#223d2b" />
    <SolidColorBrush x:Key="RemoveHoverFg" Color="#ff5252" />

    <!-- Windows Control Buttons -->
    <SolidColorBrush x:Key="WinBtnBg" Color="Transparent" />
    <SolidColorBrush x:Key="WinBtnFg" Color="#738c7d" />
    <SolidColorBrush x:Key="WinCloseBg" Color="#e81123" />
    <SolidColorBrush x:Key="WinMaxBg" Color="#1c3024" />
    <SolidColorBrush x:Key="WinMinBg" Color="#1c3024" />

    <!-- ═══ GLOWS ═══ -->
    <Color x:Key="GlowPrimary">#1000e676</Color>
    <Color x:Key="GlowSecondary">#08006634</Color>

</ResourceDictionary>
