<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ BASE COLORS (CRIMSON RED) ═══ -->
    <Color x:Key="WindowBgColor">#170B0D</Color>
    <Color x:Key="SidebarBgColor">#100709</Color>
    <Color x:Key="CardBgColor">#251114</Color>
    <Color x:Key="InnerCardBgColor">#1C0C10</Color>
    
    <Color x:Key="AccentColor">#F04461</Color>
    <Color x:Key="AccentPillColor">#F04461</Color>
    <Color x:Key="SystemAccentColor">#F04461</Color>
    <Color x:Key="SystemAccentColorDark1">#C52F4A</Color>

    <!-- ═══ TEXT COLORS ═══ -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff" />
    <SolidColorBrush x:Key="TextSecondary" Color="#E6C6CD" />
    <SolidColorBrush x:Key="TextMuted" Color="#CEAAB2" />
    <SolidColorBrush x:Key="TextDimmed" Color="#AF8790" />
    <SolidColorBrush x:Key="TextVeryDimmed" Color="#8B6670" />
    <SolidColorBrush x:Key="TextLabel" Color="#B05A68" />
    <SolidColorBrush x:Key="TextError" Color="#ff5252" />
    <SolidColorBrush x:Key="TextWatermark" Color="#170B0D" />

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#C52F4A" />
    
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SecondaryBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#46232B" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#32181E" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2A1319" />
    <SolidColorBrush x:Key="SidebarLogoBg" Color="#32181E" />

    <!-- Sidebar Navigation -->
    <SolidColorBrush x:Key="SidebarHoverBg" Color="#35181F" />
    <SolidColorBrush x:Key="SidebarHoverText" Color="#ffffff" />
    <SolidColorBrush x:Key="SidebarPressedBg" Color="#281117" />
    <SolidColorBrush x:Key="SidebarActiveBg" Color="#48212B" />
    <SolidColorBrush x:Key="SidebarActiveText" Color="{StaticResource AccentColor}" />

    <!-- Cards & Surfaces -->
    <SolidColorBrush x:Key="ElevatedBackground" Color="#30151B" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="InnerCardBackground" Color="{StaticResource InnerCardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#4B242E" />
    <SolidColorBrush x:Key="SurfaceDivider" Color="#5D303A" />

    <!-- Launch Bar -->
    <SolidColorBrush x:Key="LaunchBarBackground" Color="#130809" />
    <SolidColorBrush x:Key="LaunchBarBorderBrush" Color="#35171D" />
    <SolidColorBrush x:Key="LaunchBarInnerBg" Color="#2A1218" />
    <SolidColorBrush x:Key="LaunchBarInnerBorder" Color="#48212B" />

    <!-- Badges & Pills -->
    <Color x:Key="AccentPillBgColor">#F04461</Color>
    <SolidColorBrush x:Key="AccentPillBorder" Color="#7F2437" />
    
    <SolidColorBrush x:Key="BadgeTypeBg" Color="#491722" />
    <SolidColorBrush x:Key="BadgeTypeFg" Color="#F04461" />

    <!-- ═══ BUTTONS ═══ -->
    <!-- Play Button Gradient -->
    <Color x:Key="PlayBtnTop">#C52F4A</Color>
    <Color x:Key="PlayBtnBottom">#A6223A</Color>
    <Color x:Key="PlayBtnHoverTop">#D23A55</Color>
    <Color x:Key="PlayBtnHoverBottom">#C52F4A</Color>
    <Color x:Key="PlayBtnPressedTop">#B82742</Color>
    <Color x:Key="PlayBtnPressedBottom">#861B33</Color>

    <!-- Microsoft Button -->
    <SolidColorBrush x:Key="MicrosoftBtnBg" Color="#ffffff" />
    <SolidColorBrush x:Key="MicrosoftBtnFg" Color="#222222" />
    <SolidColorBrush x:Key="MicrosoftBtnBorder" Color="#cccccc" />
    <SolidColorBrush x:Key="MicrosoftBtnHoverBg" Color="#e6e6e6" />

    <!-- Remove Button -->
    <SolidColorBrush x:Key="RemoveHoverBg" Color="#5D303A" />
    <SolidColorBrush x:Key="RemoveHoverFg" Color="#ff5252" />

    <!-- Windows Control Buttons -->
    <SolidColorBrush x:Key="WinBtnBg" Color="Transparent" />
    <SolidColorBrush x:Key="WinBtnFg" Color="#AF8790" />
    <SolidColorBrush x:Key="WinCloseBg" Color="#DC3545" />
    <SolidColorBrush x:Key="WinMaxBg" Color="#46232B" />
    <SolidColorBrush x:Key="WinMinBg" Color="#46232B" />

    <!-- ═══ GLOWS ═══ -->
    <Color x:Key="GlowPrimary">#10ff1744</Color>
    <Color x:Key="GlowSecondary">#0880001a</Color>

    <x:Boolean x:Key="IsDarkTheme">True</x:Boolean>
    <Color x:Key="PieceWindowBackground">#170B0D</Color>
    <Color x:Key="PieceTopBarBackground">#130809</Color>
    <Color x:Key="PieceSidebarBackground">#100709</Color>
    <Color x:Key="PieceChromeBorder">#46232B</Color>
    <Color x:Key="PieceWindowControlButtonBackground">#32181E</Color>
    <Color x:Key="PieceBlueFaceTop">#251114</Color>
    <Color x:Key="PieceBlueFaceBottom">#30151B</Color>
    <Color x:Key="PieceBlueFaceBorder">#4B242E</Color>
    <Color x:Key="PieceBlueBase">#170B0D</Color>
    <Color x:Key="PieceBlueHoverTop">#35181F</Color>
    <Color x:Key="PieceBlueHoverBottom">#48212B</Color>
    <Color x:Key="PieceBlueHoverBorder">#5D303A</Color>
    <Color x:Key="PieceOrangeFaceTop">#C52F4A</Color>
    <Color x:Key="PieceOrangeFaceBottom">#A6223A</Color>
    <Color x:Key="PieceOrangeFaceBorder">#FF7188</Color>
    <Color x:Key="PieceOrangeBase">#491722</Color>
    <Color x:Key="PieceOrangeHoverTop">#D23A55</Color>
    <Color x:Key="PieceOrangeHoverBottom">#C52F4A</Color>
    <Color x:Key="PieceOrangeHoverBorder">#FF9AA9</Color>
    <Color x:Key="PieceCardBackground">#251114</Color>
    <Color x:Key="PieceCardBorder">#4B242E</Color>
    <Color x:Key="PieceTextPrimary">#FFFFFF</Color>
    <Color x:Key="PieceTextSecondary">#E6C6CD</Color>
    <Color x:Key="PieceKeyboardFocus">#F04461</Color>
    <SolidColorBrush x:Key="PieceWindowBackgroundBrush" Color="#170B0D" />
    <SolidColorBrush x:Key="PieceTopBarBackgroundBrush" Color="#130809" />
    <SolidColorBrush x:Key="PieceSidebarBackgroundBrush" Color="#100709" />
    <SolidColorBrush x:Key="PieceChromeBorderBrush" Color="#46232B" />
    <SolidColorBrush x:Key="PieceWindowControlButtonBackgroundBrush" Color="#32181E" />
    <SolidColorBrush x:Key="PieceCardBackgroundBrush" Color="#251114" />
    <SolidColorBrush x:Key="PieceCardBorderBrush" Color="#4B242E" />
    <SolidColorBrush x:Key="PieceTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PieceTextSecondaryBrush" Color="#E6C6CD" />
    <SolidColorBrush x:Key="PieceLoadingOverlayBrush" Color="#E6140505" />
    <SolidColorBrush x:Key="PieceKeyboardFocusBrush" Color="#F04461" />
    <SolidColorBrush x:Key="PieceBlueFaceBorderBrush" Color="#4B242E" />
    <SolidColorBrush x:Key="PieceBlueHoverBorderBrush" Color="#5D303A" />
    <SolidColorBrush x:Key="PieceBlueBaseBrush" Color="#170B0D" />
    <SolidColorBrush x:Key="PieceOrangeFaceBorderBrush" Color="#FF7188" />
    <SolidColorBrush x:Key="PieceOrangeHoverBorderBrush" Color="#FF9AA9" />
    <SolidColorBrush x:Key="PieceOrangeBaseBrush" Color="#491722" />
    <LinearGradientBrush x:Key="PieceBlueFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#251114" Offset="0" /><GradientStop Color="#30151B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceBlueHoverFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#35181F" Offset="0" /><GradientStop Color="#48212B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceOrangeFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C52F4A" Offset="0" /><GradientStop Color="#A6223A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PieceOrangeHoverFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D23A55" Offset="0" /><GradientStop Color="#C52F4A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#170B0D" />
    <SolidColorBrush x:Key="ThemeTopBarBackgroundBrush" Color="#130809" />
    <SolidColorBrush x:Key="ThemeSidebarBackgroundBrush" Color="#100709" />
    <SolidColorBrush x:Key="ThemeChromeBorderBrush" Color="#46232B" />
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#251114" />
    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#4B242E" />
    <SolidColorBrush x:Key="ThemeLoadingOverlayBrush" Color="#E6140505" />

</ResourceDictionary>
